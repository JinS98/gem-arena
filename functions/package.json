{
  "name": "@gem-arena/functions",
  "version": "0.1.0",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && esbuild src/index.ts --bundle --platform=node --format=cjs --target=node22 --outfile=lib/index.js --external:firebase-admin/* --external:firebase-functions/* --external:zod --alias:@gem-arena/engine=../packages/game-engine/dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "typescript": "^5.7.0"
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function roomMember(roomCode) {
      let roomPath = /databases/$(database)/documents/rooms/$(roomCode);
      return signedIn() && exists(roomPath) &&
        request.auth.uid in get(roomPath).data.playerOrder;
    }

    function validPlayer(player, uid) {
      return player.keys().hasOnly(['uid', 'nickname', 'ready', 'forfeited', 'joinedAt']) &&
        player.keys().hasAll(['uid', 'nickname', 'ready', 'forfeited', 'joinedAt']) &&
        player.uid == uid &&
        player.nickname is string &&
        player.nickname.size() >= 2 &&
        player.nickname.size() <= 16 &&
        player.ready == false &&
        player.forfeited == false &&
        player.joinedAt == request.time;
    }

    function validRoomCreate(roomCode) {
      let data = request.resource.data;
      return roomCode.matches('^[A-HJ-NP-Z2-9]{8}$') &&
        data.keys().hasOnly(['roomCode', 'hostUid', 'status', 'capacity', 'playerOrder', 'players', 'createdAt', 'updatedAt']) &&
        data.keys().hasAll(['roomCode', 'hostUid', 'status', 'capacity', 'playerOrder', 'players', 'createdAt', 'updatedAt']) &&
        data.roomCode == roomCode &&
        data.hostUid == request.auth.uid &&
        data.status == 'waiting' &&
        data.capacity == 4 &&
        data.playerOrder == [request.auth.uid] &&
        data.players.keys().hasOnly([request.auth.uid]) &&
        data.players.keys().hasAll([request.auth.uid]) &&
        validPlayer(data.players[request.auth.uid], request.auth.uid) &&
        data.createdAt == request.time &&
        data.updatedAt == request.time;
    }

    function validRoomJoin() {
      let uid = request.auth.uid;
      let before = resource.data;
      let after = request.resource.data;
      return before.status == 'waiting' &&
        before.playerOrder.size() < before.capacity &&
        !(uid in before.players) &&
        after.diff(before).affectedKeys().hasOnly(['playerOrder', 'players', 'updatedAt']) &&
        after.playerOrder == before.playerOrder.concat([uid]) &&
        after.players.diff(before.players).affectedKeys() == [uid].toSet() &&
        after.players.diff(before.players).addedKeys() == [uid].toSet() &&
        validPlayer(after.players[uid], uid) &&
        after.updatedAt == request.time;
    }

    function validReadyChange() {
      let uid = request.auth.uid;
      let before = resource.data;
      let after = request.resource.data;
      return before.status == 'waiting' &&
        uid in before.players &&
        after.diff(before).affectedKeys().hasOnly(['players', 'updatedAt']) &&
        after.players.diff(before.players).affectedKeys() == [uid].toSet() &&
        after.players[uid].diff(before.players[uid]).affectedKeys() == ['ready'].toSet() &&
        after.players[uid].ready is bool &&
        after.players[uid].ready != before.players[uid].ready &&
        after.updatedAt == request.time;
    }

    function playerReadyAt(index) {
      let data = resource.data;
      return index >= data.playerOrder.size() ||
        data.players[data.playerOrder[index]].ready == true;
    }

    function validGameStart() {
      let before = resource.data;
      let after = request.resource.data;
      return before.status == 'waiting' &&
        before.hostUid == request.auth.uid &&
        before.playerOrder.size() >= 2 &&
        before.playerOrder.size() <= before.capacity &&
        playerReadyAt(0) && playerReadyAt(1) &&
        playerReadyAt(2) && playerReadyAt(3) &&
        after.diff(before).affectedKeys().hasOnly(['status', 'startedAt', 'updatedAt']) &&
        after.diff(before).addedKeys() == ['startedAt'].toSet() &&
        after.status == 'playing' &&
        after.startedAt == request.time &&
        after.updatedAt == request.time;
    }

    match /rooms/{roomCode} {
      allow get: if signedIn() && request.auth.uid in resource.data.playerOrder;
      allow list, delete: if false;
      allow create: if signedIn() && validRoomCreate(roomCode);
      allow update: if signedIn() &&
        (validRoomJoin() || validReadyChange() || validGameStart());

      match /game/publicState {
        allow get: if roomMember(roomCode);
        allow list, write: if false;
      }

      match /privatePlayers/{uid} {
        allow get: if roomMember(roomCode) && request.auth.uid == uid;
        allow list, write: if false;
      }

      match /privateState/server {
        allow read, write: if false;
      }

      match /actionReceipts/{uid}/actions/{actionId} {
        allow read, write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
